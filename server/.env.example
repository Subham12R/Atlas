# Copy to .env and paste your API keys. SENSITIVE -- .env is gitignored.
# Development: set a strong ATLAS_API_TOKEN in BOTH server and desktop process
# environments. Packaged Electron creates a fresh token automatically; do not
# hardcode a token in this template or log it.
# Keys saved later via the desktop app's Profile -> Advanced settings are
# stored in CREDENTIALS_DB_PATH instead and take precedence over these.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Custom cloud endpoint: any hosted OpenAI-compatible API (Together, Groq, DeepSeek, ...).
# HTTPS is required unless the server runs on this computer.
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# Local LLM (Ollama or any other OpenAI-compatible local server). No API key
# needed by default.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# Web search / research mode (Tavily -- tavily.com)
TAVILY_API_KEY=

# Voice typing (Groq Whisper -- console.groq.com)
GROQ_API_KEY=

# Runtime overrides written by the Advanced settings UI live here instead of
# being rewritten into .env -- .env only seeds the very first value.
CREDENTIALS_DB_PATH=credentials.db

# ---- Brain (persistent memory core) --------------------------------------
# All optional; sensible defaults shown. See ARCHITECTURE.md.
ATLAS_LOCAL_AGENT_TIMEOUT_SECONDS=180    # local agent/research deadline; clamped to 90–300 seconds
BRAIN_ENABLED=1                          # 0 = plain adapters, no memory
BRAIN_DB_PATH=brain.db                   # SQLite file (gitignore it)
BRAIN_EMBED_MODEL=google/embeddinggemma-2 # on-device EmbeddingGemma 2 (one-time ~350 MB download); or any fastembed model, e.g. BAAI/bge-small-en-v1.5
BRAIN_EMBED_DIM=768                      # 768 (or Matryoshka 512/256/128) for EmbeddingGemma 2; 384 for bge-small. Changing model/dim re-embeds stored text
BRAIN_SUMMARIZER=                        # empty = chat's own cloud provider (local chats: RAG only)
BRAIN_AUTO_SUMMARY=1                     # 0 = RAG only (no LLM summary/graph, no extra quota)
BRAIN_TOPK=6                             # chat-memory passages per turn
BRAIN_MAX_DISTANCE=                      # memory cosine cutoff; blank = model default (0.36 EmbeddingGemma 2, 0.6 bge-small)
BRAIN_CONTEXT_BUDGET=2000                # max chars of recalled chat memory per turn
BRAIN_DOCUMENTS=1                        # 1 = indexed documents join chat answers, cited as [D1]
BRAIN_DOC_TOPK=4                         # document passages per turn
BRAIN_DOC_BUDGET=6000                    # max chars of document passages per turn
BRAIN_DOC_MAX_DISTANCE=                  # passage cosine cutoff; blank = model default
BRAIN_ENTITY_DISTANCE=                   # entity-name match cutoff for graph retrieval; blank = model default
BRAIN_CHUNK_CHARS=1000                   # target chunk size (paragraph/sentence aligned)
BRAIN_CHUNK_OVERLAP=150                  # chars of trailing context carried into the next chunk
